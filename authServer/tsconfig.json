{
  "compilerOptions": {
    "target": "ES2022", // Use a modern ECMAScript version
    "module": "NodeNext", // Use the modern Node.js module system
    "moduleResolution": "NodeNext", // How modules get resolved
    "baseUrl": ".", // Base directory for module resolution
    "outDir": "./dist", // Where to output compiled JavaScript
    "rootDir": "./src", // The root directory of our source files
    "esModuleInterop": true, // Allows interoperability with CommonJS modules
    "forceConsistentCasingInFileNames": true,
    "strict": true, // Enable all strict type-checking options
    "skipLibCheck": true, // Skip type checking of declaration files
    "sourceMap": true // Generate source maps for debugging
  },
  "include": ["src/**/*"], // Which files to include in compilation
  "exclude": ["node_modules"] // Which files to exclude
}
